{
  "name": "draw-physics-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/spa-404.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mechanics": "vitest run src/demos/mechanics",
    "test:em": "vitest run src/demos/em",
    "test:optics": "vitest run src/demos/optics",
    "audit:mechanics": "node scripts/audit-mechanics.mjs",
    "audit:em-optics": "node scripts/audit-em-optics.mjs",
    "list:demos": "node scripts/list-demos.mjs",
    "typecheck": "vue-tsc -b --pretty false"
  },
  "dependencies": {
    "katex": "^0.16.21",
    "pinia": "^3.0.1",
    "three": "^0.174.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.6",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.65.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.8"
  }
}
